{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reserva de origen CaribeAir",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nombre",
    "fecha",
    "precio",
    "maleta",
    "tipoPasajero"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nombre": {
      "type": "string",
      "minLength": 3
    },
    "fecha": {
      "type": "string",
      "pattern": "^[0-1][0-9]/[0-3][0-9]/[0-9]{4}$"
    },
    "precio": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\\.[0-9]{1,2})?$"
    },
    "maleta": {
      "type": "string",
      "pattern": "^[0-9]+\\s+pieza(s)?$"
    },
    "tipoPasajero": {
      "type": "string",
      "enum": [
        "ADT",
        "CHD",
        "INF"
      ]
    }
  }
}